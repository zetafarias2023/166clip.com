rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Cualquier persona con sesión iniciada puede subir imágenes a su propia carpeta.
    // Ya no depende de Firestore ni de ningún "permiso de subida".
    function isImage() { return request.resource.contentType.matches('image/(jpeg|png|webp|gif)'); }
    function ownerUpload(uid, maxBytes) {
      return request.auth != null && request.auth.uid == uid
        && request.resource.size < maxBytes && isImage();
    }
    function audioUpload(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/(webm|ogg|mp4|mpeg|aac|x-m4a)');
    }
    function ownerDelete(uid) { return request.auth != null && request.auth.uid == uid; }

    // Trabajos del portafolio: hasta 25 MB.
    match /portfolio/{uid}/{file} {
      allow read: if true;
      allow create: if ownerUpload(uid, 25 * 1024 * 1024);
      allow delete: if ownerDelete(uid);
    }
    // Los avatares y banners viejos ya no se usan: solo se permite leer y borrar los que ya estaban subidos.
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow delete: if ownerDelete(uid);
    }
    match /banners/{uid}/{file} {
      allow read: if true;
      allow delete: if ownerDelete(uid);
    }
    match /stories/{uid}/{file} {
      allow read: if true;
      allow delete: if ownerDelete(uid);
    }
    // Notas de voz de los chats (ya no se envían fotos): solo las ve quien tiene sesión iniciada.
    match /chat/{uid}/{file} {
      allow read: if request.auth != null;
      allow create: if audioUpload(uid);
      allow delete: if ownerDelete(uid);
    }
  }
}
